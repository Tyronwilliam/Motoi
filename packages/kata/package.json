{
  "name": "@motoi/kata",
  "version": "0.0.1",
  "description": "Motoi design system — React component library.",
  "type": "module",
  "license": "MIT",
  "author": "Tyron - William Chanu",
  "homepage": "https://github.com/Tyronwilliam/Motoi/tree/main/packages/kata#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tyronwilliam/Motoi.git",
    "directory": "packages/kata"
  },
  "scripts": {
    "dev": "nx storybook kata",
    "ui:add": "bunx --bun shadcn@latest add",
